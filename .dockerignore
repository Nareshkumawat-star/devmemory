# Dependencies (installed inside the image)
node_modules/

# Next.js build output (regenerated by `next build`)
.next/
out/
build/
.vercel/

# Tests
coverage/
test-results/
playwright-report/
*.test.*
*.spec.*

# Local env files — never bake these into an image.
# Real secrets are passed at run time (`docker run -e` / Render env vars).
.env
.env*.local
.env.development
.env.test
.env.local.bak

# Git / editor / OS
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~
*.log
.DS_Store
Thumbs.db

# Docker config
Dockerfile*
.dockerignore
compose.yaml
compose.yml
docker-compose*

# Docs and agent metadata
*.md
AGENTS.md
.agents/
.github/

# Caches
.cache/
.eslintcache
.turbo/
.tmp/
temp/

# TypeScript build metadata
*.tsbuildinfo
next-env.d.ts
